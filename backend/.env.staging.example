# Staging environment settings
# COPY THIS FILE TO .env.staging AND FILL IN PROPER VALUES

# Server configuration
PORT=3001
NODE_ENV=staging
AUTO_MIGRATE=true # Auto migrations OK for staging

# Database configuration
# For MongoDB Atlas (separate from production)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/social-engagement-staging

# JWT configuration - GENERATE A STRONG RANDOM SECRET
JWT_SECRET=staging_jwt_secret_at_least_32_chars_long
JWT_EXPIRATION=7d

# Twitter API configuration (use test or staging keys)
TWITTER_API_KEY=your_staging_twitter_api_key
TWITTER_API_SECRET=your_staging_twitter_api_secret
TWITTER_BEARER_TOKEN=your_staging_twitter_bearer_token
TWITTER_ACCESS_TOKEN=your_staging_twitter_access_token
TWITTER_ACCESS_SECRET=your_staging_twitter_access_secret

# Web3 configuration (use testnet values)
INFURA_API_KEY=your_infura_api_key
CONTRACT_ADDRESSES='{"socialToken":"0xtest123...","contentRegistry":"0xtest456...","engagement":"0xtest789...","competition":"0xtestABC..."}'
DEFAULT_NETWORK=sepolia

# Redis configuration
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=staging_redis_password

# Rate limiting - less strict than production
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=200
RATE_LIMIT_SIGNUP_WINDOW=60
RATE_LIMIT_SIGNUP_MAX=10

# Security and Privacy Settings
CONSENT_VERSION=1.0.0
PRIVACY_POLICY_URL=https://staging.yourdomain.com/privacy
TERMS_URL=https://staging.yourdomain.com/terms
DATA_RETENTION_DAYS=730

# Consent and Verification Settings
VERIFY_CODE_EXPIRY_SECONDS=3600
ADMIN_BYPASS_CONSENT=false

# Ethical Data Collection Settings
DATA_COLLECTION_MODE=ethical
STORE_VERIFICATION_ONLY=true
ALLOW_BOT_DETECTION=false
DATA_ANONYMIZATION=true

# CORS Configuration
CORS_ORIGIN=https://staging.yourdomain.com

# Logging and Monitoring - verbose for staging
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true
SENTRY_DSN=your_staging_sentry_dsn
ENABLE_PROMETHEUS=true

# Email configuration
SENDGRID_API_KEY=your_staging_sendgrid_api_key
EMAIL_FROM=noreply@staging.yourdomain.com
EMAIL_ADMIN=admin@yourdomain.com

# CDN configuration
ASSETS_DOMAIN=https://assets.staging.yourdomain.com
CDN_PUBLIC_URL=https://cdn.staging.yourdomain.com

# Performance tuning - less resource-intensive than production
NODE_OPTIONS="--max-old-space-size=1024"
CLUSTER_MODE=false
WORKER_THREADS=2