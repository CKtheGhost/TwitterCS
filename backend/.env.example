# Server configuration
PORT=5000
NODE_ENV=development
AUTO_MIGRATE=true

# Database configuration
MONGODB_URI=mongodb://localhost:27017/social-engagement

# JWT configuration
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRATION=7d

# Twitter API configuration (official API access only - no scraping)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Web3 configuration
INFURA_API_KEY=
CONTRACT_ADDRESSES='{"socialToken":"","contentRegistry":"","engagement":"","competition":""}'
DEFAULT_NETWORK=sepolia

# Redis configuration (optional)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Security and Privacy Settings
CONSENT_VERSION=1.0.0
PRIVACY_POLICY_URL=/privacy
TERMS_URL=/terms
DATA_RETENTION_DAYS=730 # 2 years

# Consent and Verification Settings
VERIFY_CODE_EXPIRY_SECONDS=3600 # 1 hour
ADMIN_BYPASS_CONSENT=false # Set to true only in development

# Ethical Data Collection Settings
DATA_COLLECTION_MODE=ethical # Options: ethical, minimal
STORE_VERIFICATION_ONLY=true # Only store verification status, not actual tweets
ALLOW_BOT_DETECTION=false # Only enable with explicit consent
DATA_ANONYMIZATION=true # Anonymize data for analytics

# Other settings
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
AUDIT_LOG_ENABLED=true