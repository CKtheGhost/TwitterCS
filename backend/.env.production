# Production environment configuration
PORT=3001
NODE_ENV=production
# Use local MongoDB container for now
MONGODB_URI=mongodb://mongodb:27017/social-engagement

# For Atlas in production, uncomment and update with correct credentials
# MONGODB_URI=mongodb+srv://<username>:<password>@mycluster.6ynq3x6.mongodb.net/social-engagement
# JWT_SECRET should be set through environment variables in production
LOG_LEVEL=warn
CORS_ORIGIN=https://app.socialengagement.example.com