# Production environment settings
# COPY THIS FILE TO .env.production AND FILL IN PROPER VALUES

# Server configuration
PORT=3001
NODE_ENV=production
AUTO_MIGRATE=false # Run migrations manually in production

# Database configuration
# For MongoDB Atlas (recommended for production)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/social-engagement

# For local MongoDB or Docker setup
# MONGODB_URI=mongodb://mongodb:27017/social-engagement

# JWT configuration - GENERATE A STRONG RANDOM SECRET FOR PRODUCTION!
JWT_SECRET=replace_with_at_least_32_character_random_string_
JWT_EXPIRATION=7d

# Twitter API configuration (official API access only - no scraping)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# Web3 configuration
INFURA_API_KEY=your_infura_api_key
CONTRACT_ADDRESSES='{"socialToken":"0x123...","contentRegistry":"0x456...","engagement":"0x789...","competition":"0xabc..."}'
DEFAULT_NETWORK=mainnet

# Redis configuration (highly recommended for production)
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=your_strong_redis_password

# Rate limiting - stricter limits for production
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=50
RATE_LIMIT_SIGNUP_WINDOW=60
RATE_LIMIT_SIGNUP_MAX=5

# Security and Privacy Settings
CONSENT_VERSION=1.0.0
PRIVACY_POLICY_URL=https://yourdomain.com/privacy
TERMS_URL=https://yourdomain.com/terms
DATA_RETENTION_DAYS=730 # 2 years

# Consent and Verification Settings
VERIFY_CODE_EXPIRY_SECONDS=3600 # 1 hour
ADMIN_BYPASS_CONSENT=false # Must be false in production

# Ethical Data Collection Settings
DATA_COLLECTION_MODE=ethical
STORE_VERIFICATION_ONLY=true
ALLOW_BOT_DETECTION=false
DATA_ANONYMIZATION=true

# CORS Configuration - restrict to your domain
CORS_ORIGIN=https://app.yourdomain.com

# Logging and Monitoring
LOG_LEVEL=warn
AUDIT_LOG_ENABLED=true
SENTRY_DSN=your_sentry_dsn
ENABLE_PROMETHEUS=true
HONEYCOMB_API_KEY=your_honeycomb_api_key

# Email configuration
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_ADMIN=admin@yourdomain.com

# CDN configuration
ASSETS_DOMAIN=https://assets.yourdomain.com
CDN_PUBLIC_URL=https://cdn.yourdomain.com

# Performance tuning
NODE_OPTIONS="--max-old-space-size=2048"
CLUSTER_MODE=true
WORKER_THREADS=4