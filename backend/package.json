    "ethers": "^6.0.8",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^6.15.0",
    "helmet": "^8.1.0",
    "helmet-csp": "^4.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.0",
    "moment": "^2.30.1",
    "mongodb": "^6.16.0",
    "mongoose": "^7.8.7",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "twitter-api-v2": "^1.22.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
