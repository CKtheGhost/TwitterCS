{
  "name": "social-engagement-platform-backend",
  "version": "1.0.0",
  "description": "Backend for social engagement platform with smart contract integration",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "test:coverage": "jest --coverage",
    "migrate": "node src/migrations/runMigration.js up",
