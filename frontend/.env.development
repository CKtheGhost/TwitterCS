# Development environment configuration
REACT_APP_DEFAULT_NETWORK=localhost

# API configuration
REACT_APP_API_URL=http://localhost:5000/api

# Privacy and Consent Settings
REACT_APP_PRIVACY_POLICY_URL=/privacy
REACT_APP_TERMS_URL=/terms

# Default Consent Settings (all default to false for privacy)
REACT_APP_DEFAULT_CONSENT_SOCIAL_VERIFICATION=false
REACT_APP_DEFAULT_CONSENT_ENGAGEMENT_METRICS=false
REACT_APP_DEFAULT_CONSENT_PUBLIC_PROFILE=false
REACT_APP_DEFAULT_CONSENT_ON_CHAIN_ACTIVITY=false

# Authentication
REACT_APP_AUTH_STORAGE_KEY=social_engage_auth_dev
REACT_APP_AUTH_EXPIRY_DAYS=7

# Analytics and Tracking (disabled in development)
REACT_APP_ENABLE_ANALYTICS=false

# Feature flags
REACT_APP_ENABLE_TWITTER_VERIFICATION=true
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_FEATURE_PRIVACY_DASHBOARD=true